rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile validation
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    // Study note validation
    function isValidStudyNote(data) {
      return data.keys().hasAll(['userId', 'question', 'answer', 'isSaved', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'question', 'answer', 'topic', 'isSaved', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.question is string && data.question.size() > 0 && data.question.size() <= 2000
        && data.answer is string && data.answer.size() > 0 && data.answer.size() <= 30000
        && data.isSaved is bool
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 50
        && (!('topic' in data) || (data.topic is string && data.topic.size() <= 100));
    }

    // Users collection rules
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // Study notes collection rules
    match /studyNotes/{noteId} {
      allow get: if isSignedIn() && isValidId(noteId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(noteId)
        && isValidStudyNote(incoming())
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(noteId)
        && resource.data.userId == request.auth.uid
        && isValidStudyNote(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(noteId) && resource.data.userId == request.auth.uid;
    }
  }
}
